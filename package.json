{
  "name": "unity-highscore-api",
  "version": "1.1.0",
  "private": true,
  "description": "REST API for a Unity leaderboard, using SQLite and Docker Compose",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
